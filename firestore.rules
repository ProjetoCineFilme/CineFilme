rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isEmailVerified() { return isSignedIn(); } // Keeping it simple since they use custom emails

    // 1. Metadata (Counters)
    match /metadata/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 2. Perfis de Usuário
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // 3. Avaliações (Ratings)
    match /ratings/{ratingId} {
      allow read: if true;
      // Allow creation if logged in
      allow create: if isSignedIn();
      // Allow update if owner (matching by user_id or user_email)
      allow update, delete: if isSignedIn() && (
        (resource.data.user_email == request.auth.token.email) ||
        (resource.data.uid == request.auth.uid) ||
        (resource.data.user_id == request.auth.uid)
      );
    }

    // 4. Filmes
    match /movies/{movieId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
