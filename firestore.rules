rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para a coleção de usuários (Perfis)
    match /users/{userId} {
      // Permite ler se estiver logado
      allow read: if request.auth != null;
      // Permite escrever apenas no seu próprio documento (UID)
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regras para a coleção de avaliações
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.resource.data.user_email == request.auth.token.email || 
        resource.data.user_email == request.auth.token.email
      );
    }

    // Regras para filmes
    match /movies/{movieId} {
      allow read: if true;
    }

    // Bloqueio padrão para qualquer outra coisa
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
