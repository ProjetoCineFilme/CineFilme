rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Essencial para o ID sequencial (1, 2, 3...)
    match /metadata/users_counter {
      allow read, write: if request.auth != null;
    }

    // Perfis de Usuário
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Avaliações
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.user_email == request.auth.token.email
      );
    }

    // Filmes (Usuários podem cadastrar novos filmes agora!)
    match /movies/{movieId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false; // Por segurança, não deixamos usuários comuns editarem filmes globais
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
