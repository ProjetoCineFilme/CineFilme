rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de ajuda
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // 1. Contador de Usuários (Metadata)
    match /metadata/{docId} {
      allow read, write: if isSignedIn();
    }

    // 2. Perfis de Usuário
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // 3. Avaliações (Ratings)
    match /ratings/{ratingId} {
      allow read: if true;
      // Permite criar se estiver logado
      allow create: if isSignedIn();
      // Permite atualizar ou deletar se o UID ou o e-mail baterem com o logado
      allow update, delete: if isSignedIn() && (
        (resource.data.uid == request.auth.uid) ||
        (resource.data.user_email == request.auth.token.email) ||
        (resource.data.user_id == request.auth.uid)
      );
    }

    // 4. Filmes
    match /movies/{movieId} {
      allow read: if true;
      // Importante: allow write permite create e update para usuários logados
      allow write: if isSignedIn();
    }

    // Bloqueio padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
