rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entities
    function isValidRating(data) {
      return data.keys().hasAll(['user_id', 'movie_id', 'rating']) 
        && data.keys().size() == 3
        && data.user_id is int
        && data.movie_id is int
        && data.rating is number
        && data.rating >= 1 && data.rating <= 5;
    }

    function isValidMovie(data) {
      return data.keys().hasAll(['movie_id', 'title'])
        && data.keys().size() == 2
        && data.movie_id is int
        && data.title is string && data.title.size() <= 200;
    }

    // Collections
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isValidRating(request.resource.data);
      allow update, delete: if false; // Ratings are immutable in this MVP
    }

    match /movies/{movieId} {
      allow read: if true;
      allow create: if isValidMovie(request.resource.data);
      allow update, delete: if false;
    }
  }
}
