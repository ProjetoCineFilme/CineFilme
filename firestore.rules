rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Contador Global para IDs sequenciais (1, 2, 3...)
    match /metadata/users_counter {
      // Permite que qualquer usuário logado incremente o contador durante o cadastro
      allow read, write: if request.auth != null;
    }

    // 2. Perfis de Usuário
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Avaliações (Ratings)
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Só o dono pode editar ou deletar sua avaliação
      allow update, delete: if request.auth != null && (
        resource.data.user_email == request.auth.token.email
      );
    }

    // 4. Filmes
    match /movies/{movieId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false; 
    }

    // Bloqueio padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
