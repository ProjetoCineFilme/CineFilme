rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra básica para perfis de usuário
    match /users/{userId} {
      // Permite que qualquer usuário logado leia perfis de outros (necessário para validações às vezes)
      // Mas restringe a escrita apenas ao próprio dono
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regra para avaliações de filmes
    match /ratings/{ratingId} {
      allow read: if true;
      // Permite criar avaliações se estiver logado
      allow create: if request.auth != null;
      // Permite atualizar/deletar apenas se for o e-mail do dono (ou podemos usar UID no futuro)
      allow update, delete: if request.auth != null && (request.auth.token.email == resource.data.user_email);
    }

    // Regra para filmes (público)
    match /movies/{movieId} {
      allow read: if true;
    }

    // Lock down default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
