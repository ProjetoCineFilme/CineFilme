{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile linking Firebase Auth UID to a numeric sequence ID",
      "type": "object",
      "properties": {
        "user_id": { "type": "integer" },
        "email": { "type": "string" },
        "uid": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "uid", "email"]
    },
    "Rating": {
      "title": "Rating",
      "description": "A user's rating for a movie",
      "type": "object",
      "properties": {
        "user_id": { "type": "integer" },
        "movie_id": { "type": "string" },
        "rating": { "type": "integer" },
        "user_email": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "movie_id", "rating"]
    },
    "Movie": {
      "title": "Movie",
      "description": "Movie metadata",
      "type": "object",
      "properties": {
        "movie_id": { "type": "string" },
        "title": { "type": "string" },
        "genre": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["movie_id", "title"]
    },
    "Metadata": {
      "title": "Metadata",
      "description": "System metadata like counters",
      "type": "object",
      "properties": {
        "count": { "type": "integer" }
      }
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/ratings/{ratingId}": {
      "schema": "Rating",
      "description": "Movie ratings"
    },
    "/movies/{movieId}": {
      "schema": "Movie",
      "description": "Movie information"
    },
    "/metadata/{docId}": {
      "schema": "Metadata",
      "description": "System metadata"
    }
  }
}
